# SOC Triage Desk settings. Copy this file to .env and fill it in.
# .env is git-ignored. Never commit real keys, and never paste them into tickets or chat.

# ---------- Server ----------
# Port the app listens on. Open http://localhost:<PORT> in the browser.
PORT=3000
# Long random string used to sign session cookies (required, at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# SQLite file (relative to prisma/). For PostgreSQL later: set provider = "postgresql"
# in prisma/schema.prisma and use e.g. postgresql://user:pass@host:5432/socdesk
DATABASE_URL="file:./soc.db"
# Set to true when the app is served over HTTPS (makes the session cookie Secure).
# Leave false for http://localhost.
COOKIE_SECURE=false
# Set to 1 when running behind a reverse proxy (nginx, IIS, a load balancer) so the
# client IP in the audit log and rate limits is the real one.
TRUST_PROXY=0
# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info

# ---------- OSINT providers ----------
# A provider with an empty key is turned off and shows as "Not configured" in the app.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=
# URL-to-image screenshots (app.screenshotbase.com). Each screenshot uses quota and
# runs only after the analyst confirms. The image is stored at a public link.
SCREENSHOTBASE_API_KEY=
# How long a provider answer is reused before asking the provider again.
OSINT_CACHE_HOURS=24
# Per-provider request limits (requests per minute). Defaults match the free plans;
# raise them if your key is on a paid plan. Check each provider's plan page.
#   AbuseIPDB free: 1,000 checks/day   VirusTotal public API: 4/min, 500/day
#   urlscan.io: limits are per key, see https://urlscan.io/user/quotas/ (on HTTP 429 the
#   app waits for X-Rate-Limit-Reset-After)   Shodan: about 1/second   OTX: no published hard limit
ABUSEIPDB_RATE_PER_MIN=30
VIRUSTOTAL_RATE_PER_MIN=4
URLSCAN_RATE_PER_MIN=60
SHODAN_RATE_PER_MIN=60
OTX_RATE_PER_MIN=60
# Timeout for each provider call, in milliseconds.
OSINT_TIMEOUT_MS=10000
# urlscan.io visibility for new scans the analyst asks for: private | unlisted
URLSCAN_VISIBILITY=private

# ---------- AI assistant ----------
# none = AI off (buttons hidden). ollama = a local model through Ollama (free, nothing leaves the
# machine). gemini = Google Gemini API. anthropic = Claude (Anthropic API).
AI_PROVIDER=none
# Gemini key from https://aistudio.google.com/apikey. Use a key on a billed (paid) project for
# client data: on the free tier Google may use prompts and answers to improve its products.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Model name. Empty = qwen3.5:4b for Ollama, gemini-3.8-flash for Gemini, claude-opus-5-5 for Anthropic.
# Current Gemini models: https://ai.google.dev/gemini-api/docs/models
AI_MODEL=
# Gemini only: when AI_MODEL is busy (Google answers "high demand"), the app retries twice and
# then tries this model once. Empty = gemini-3.5-flash. Set to off to turn the fallback off.
AI_FALLBACK_MODEL=
# Ollama only. URL of the Ollama server, the context window in tokens (logs + instructions must
# fit), and how long one request may take (local models on a laptop CPU can need minutes).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_MS=600000
# Most relevant log lines sent to the AI (lines with IOCs or technique hits first).
# With a local model on a CPU, 40-60 keeps a draft to a few minutes.
AI_MAX_LOG_LINES=200
# Anthropic only: if Claude declines a request for safety reasons, retry it on Anthropic's
# recommended fallback model automatically (server-side fallback). Set to false to turn this off.
AI_REFUSAL_FALLBACK=true
